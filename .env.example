# ---------------------------------------------------------------------------
# ProxiSpeak — copy to `.env` (repo root). `server/.env` overrides this file.
# Placeholders only: never commit real credentials.
# ---------------------------------------------------------------------------

# Port the Express server listens on (4000 is the local default).
PORT=4000

# development | production
NODE_ENV=development

# MongoDB connection string (Day 2: wired into the server boot + `npm run seed`).
# Credentials are redacted before anything reaches the logs.
#   local:  mongodb://127.0.0.1:27017/proxispeak
#   Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/proxispeak?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# Allowed browser origins for CORS (comma separated), used by the HTTP API and
# by the Socket.io server (Day 3). Empty = the websocket accepts same-origin
# traffic only (no wildcard, no origin reflection); set the list below, or "*",
# to allow browser clients served from another origin.
CLIENT_URL=http://localhost:5173

# ---- Day 3: realtime channel -------------------------------------------------
# Accepted `move` events per socket per second (token bucket; bursts up to this
# value are allowed, everything above is dropped).
SOCKET_MOVE_EPS=30

# Largest distance (pixels) one accepted `move` may travel. The room is 1920 px
# wide, so 120 px is a short hop and a single event can never teleport.
SOCKET_MAX_STEP_PX=120


# ---- Week 2, Day 7: proximity and live presence -------------------------------
# CONNECT radius: a new WebRTC edge (offer/answer) is created only at <= 100 px.
PROXIMITY_RADIUS_PX=100
# Week 3, Day 13: DROP radius (hysteresis). An existing edge survives until the
# distance exceeds this value. Default = PROXIMITY_RADIUS_PX + 15, must be within
# [PROXIMITY_RADIUS_PX, 3 x PROXIMITY_RADIUS_PX]. Equal to the radius = Day 12 behaviour.
PEER_DISCONNECT_RADIUS_PX=115
# Week 3, Day 13: peer cap per user (0 = unlimited = Day 12 behaviour).
MAX_PEERS_PER_USER=8
PRESENCE_CLEANUP_INTERVAL_MS=30000
PRESENCE_TIMEOUT_MS=60000
# Random per-process id by default; override so a restarted instance keeps its id.
# MUST be unique across simultaneously running instances.
# INSTANCE_ID=office-node-1

# ---- Week 2, Day 8: peer graph and WebRTC signaling ---------------------------
# JSON array in the browser RTCPeerConnection shape; STUN only on Day 8 (no TURN
# relay/credentials). Malformed JSON, an empty array or a non-stun URL falls back
# to the default below with one warning line at boot.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Per-socket `signal` rate limit. ICE trickling is bursty, so a socket may send
# `SOCKET_SIGNAL_BURST` events at once and then SOCKET_SIGNAL_EPS per second.
SOCKET_SIGNAL_EPS=30
SOCKET_SIGNAL_BURST=200

# ---- Day 10: spatial audit (Mid-Project Review) ------------------------------
# Guarded audit endpoint/script. Default: enabled outside production, disabled
# in production. AUDIT_TARGET_MS is the p95 budget each audited operation must
# meet for an overall PASS (reported honestly, never faked).
# AUDIT_ENABLED=true
AUDIT_TARGET_MS=20

# ---- Week 3, Day 12: optional multi-instance Redis Pub/Sub & edge store ------
# Leave empty to run single-instance in memory with zero Redis dependencies.
# Supports redis:// and rediss:// (TLS); credentials are always redacted in logs.
#   local:  redis://127.0.0.1:6379
#   TLS:    rediss://user:password@redis.example.com:6380
REDIS_URL=
REDIS_KEY_PREFIX=proxispeak
EDGE_SWEEP_INTERVAL_MS=30000
# Test-only Redis URL for `npm test` (Redis suites skip loudly when unset):
# REDIS_URL_TEST=redis://127.0.0.1:6379
