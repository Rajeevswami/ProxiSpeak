# ---------------------------------------------------------------------------
# ProxiSpeak — copy to `.env` (repo root). `server/.env` overrides this file.
# Placeholders only: never commit real credentials.
# ---------------------------------------------------------------------------

# ---- server process --------------------------------------------------------

# Port the Express server listens on (4000 is the local default).
PORT=4000

# Network interface to bind to. 0.0.0.0 is the default for container/PaaS use.
# HOST=0.0.0.0

# development | production
NODE_ENV=development

# Minimum log level (debug, info, warn, error). Default is info.
# LOG_LEVEL=info

# ---- MongoDB ---------------------------------------------------------------

# MongoDB connection string (Day 2: wired into the server boot + `npm run seed`).
# Credentials are redacted before anything reaches the logs.
#   local:  mongodb://127.0.0.1:27017/proxispeak
#   Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/proxispeak?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# Server selection timeout in milliseconds for MongoDB.
# MONGO_TIMEOUT_MS=8000

# ---- HTTP / WebSocket CORS -------------------------------------------------

# Allowed browser origins for CORS (comma separated), used by the HTTP API and
# by the Socket.io server (Day 3). Empty = same-origin only in production;
# in development the HTTP layer reflects any origin as a convenience but the
# websocket still refuses cross-origin (no wildcard, no origin reflection).
# Set the list below, or "*", to allow browser clients served from another origin.
CLIENT_URL=http://localhost:5173

# ---- world projection ------------------------------------------------------
# Tangent-plane mapping: the pixel plane is projected onto a tiny globe patch.
# 10 pixels per metre = 1 px is exactly 0.1 m to MongoDB's 2dsphere engine.
# WORLD_WIDTH=1920
# WORLD_HEIGHT=1080
# WORLD_CENTER_LAT=37.7749
# WORLD_CENTER_LON=-122.4194
# PIXELS_PER_METER=10

# ---- Socket.io: move rate limits -------------------------------------------

# Accepted `move` events per socket per second (token bucket).
SOCKET_MOVE_EPS=30

# Largest distance (pixels) one accepted `move` may travel.
SOCKET_MAX_STEP_PX=120

# ---- proximity mesh --------------------------------------------------------

# CONNECT radius: a new WebRTC edge is created only at <= this many px.
PROXIMITY_RADIUS_PX=100

# DROP radius (hysteresis). An existing edge survives until the distance
# exceeds this value. Must be within [PROXIMITY_RADIUS_PX, 3 x PROXIMITY_RADIUS_PX].
PEER_DISCONNECT_RADIUS_PX=115

# Peer cap per user (0 = unlimited).
MAX_PEERS_PER_USER=8

# ---- presence cleanup ------------------------------------------------------

# How often stale presence rows are swept (milliseconds).
PRESENCE_CLEANUP_INTERVAL_MS=30000

# A presence row older than this is considered stale (milliseconds).
PRESENCE_TIMEOUT_MS=60000

# ---- instance identity -----------------------------------------------------

# Random per-process id by default; override so a restarted instance keeps its id.
# MUST be unique across simultaneously running instances.
# INSTANCE_ID=office-node-1

# ---- WebRTC ICE servers ----------------------------------------------------

# JSON array in the browser RTCPeerConnection shape; STUN only (no TURN).
# Malformed JSON, an empty array or a non-stun URL falls back to the default.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# ---- Socket.io: signal rate limits -----------------------------------------

# Per-socket `signal` rate limit. ICE trickling is bursty.
SOCKET_SIGNAL_EPS=30
SOCKET_SIGNAL_BURST=200

# ---- spatial audit ---------------------------------------------------------

# Guarded audit endpoint/script. Default: enabled outside production, disabled
# in production. AUDIT_TARGET_MS is the p95 budget for an overall PASS.
# AUDIT_ENABLED=true
AUDIT_TARGET_MS=20

# ---- optional multi-instance Redis Pub/Sub & edge store --------------------

# Leave empty to run single-instance in memory with zero Redis dependencies.
# Supports redis:// and rediss:// (TLS); credentials are always redacted in logs.
#   local:  redis://127.0.0.1:6379
#   TLS:    rediss://user:password@redis.example.com:6380
REDIS_URL=

# Key prefix shared by every Redis key this process writes.
REDIS_KEY_PREFIX=proxispeak

# How often the orphan-edge sweep runs (milliseconds).
EDGE_SWEEP_INTERVAL_MS=30000

# Connection timeout for Redis (milliseconds).
# REDIS_CONNECT_TIMEOUT_MS=3000

# TTL for every edge key in Redis (seconds).
# REDIS_EDGE_TTL_SECONDS=3600

# ---- scale-check script ----------------------------------------------------

# URLs of the two instances `npm run scale-check` probes.
# SCALE_CHECK_URL_1=http://127.0.0.1:4000
# SCALE_CHECK_URL_2=http://127.0.0.1:4001

# Room id the scale-check script uses.
# SCALE_CHECK_ROOM=lobby

# ---- test-only -------------------------------------------------------------

# Test-only Redis URL for `npm test` (Redis suites skip loudly when unset):
# REDIS_URL_TEST=redis://127.0.0.1:6379
