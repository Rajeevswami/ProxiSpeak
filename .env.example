# ProxiSpeak — copy to `.env` at the repo root; `server/.env` has priority.
# Placeholders and local defaults only: never commit real credentials.

# Port the Express and Socket.io server listens on.
PORT=4000

# Network interface to bind; 0.0.0.0 accepts connections on all interfaces.
# HOST=0.0.0.0

# Runtime mode; production changes empty-CLIENT_URL HTTP CORS to same-origin only.
NODE_ENV=development

# Minimum log level: debug, info, warn, or error.
# LOG_LEVEL=info

# MongoDB connection string; use mongodb:// locally or mongodb+srv:// for Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# MongoDB server-selection timeout in milliseconds (integer, 500..2147483647).
# MONGO_TIMEOUT_MS=8000

# Comma-separated http(s) browser origins, or *; empty means production HTTP and
# Socket.io are same-origin only, while non-production HTTP reflects origins for
# development and Socket.io remains same-origin only.
CLIENT_URL=http://localhost:5173

# World-plane width in pixels (number >= 200).
# WORLD_WIDTH=1920

# World-plane height in pixels (number >= 200).
# WORLD_HEIGHT=1080

# Tangent-plane projection centre latitude (-90..90).
# WORLD_CENTER_LAT=37.7749

# Tangent-plane projection centre longitude (-180..180).
# WORLD_CENTER_LON=-122.4194

# Projection scale; 10 pixels per metre makes 1 px equal 0.1 m.
# PIXELS_PER_METER=10

# Accepted move events per socket per second (1..1000).
SOCKET_MOVE_EPS=30

# Largest distance in pixels one accepted move may travel (1..100000).
SOCKET_MAX_STEP_PX=120

# Connect radius in pixels; new peer edges require distance <= this value.
PROXIMITY_RADIUS_PX=100

# Drop radius in pixels; valid from the connect radius through 3x that radius.
PEER_DISCONNECT_RADIUS_PX=115

# Maximum edges per user; integer 0..100000, where 0 means unlimited.
MAX_PEERS_PER_USER=8

# Stale-presence sweep interval in milliseconds (integer 1..2147483647).
PRESENCE_CLEANUP_INTERVAL_MS=30000

# Presence age in milliseconds after which a row is stale (integer 1..2147483647).
PRESENCE_TIMEOUT_MS=60000

# Unique instance id; leave unset for a random id or set a stable unique value.
# INSTANCE_ID=office-node-1

# JSON array of STUN/STUNS servers; invalid JSON falls back to public STUN.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Signal events refilled per socket per second (1..1000).
SOCKET_SIGNAL_EPS=30

# Signal token-bucket burst capacity (integer 1..10000).
SOCKET_SIGNAL_BURST=200

# Enable the spatial audit: 1/0, true/false, or yes/no; default off in production.
# AUDIT_ENABLED=true

# Spatial-audit p95 latency budget in milliseconds (0.001..60000).
AUDIT_TARGET_MS=20

# Redis URL; empty selects the in-memory single-instance store, redis:// and rediss:// are valid.
REDIS_URL=

# Redis key namespace: 1..48 letters, digits, underscores, or hyphens.
REDIS_KEY_PREFIX=proxispeak

# Orphan-edge sweep interval in milliseconds (integer 1..2147483647).
EDGE_SWEEP_INTERVAL_MS=30000

# Redis connection timeout in milliseconds (integer 100..60000).
# REDIS_CONNECT_TIMEOUT_MS=3000

# Safety TTL in seconds for Redis edge keys (integer 60..604800).
# REDIS_EDGE_TTL_SECONDS=3600

# First server base URL used by scale-check.
# SCALE_CHECK_URL_1=http://127.0.0.1:4000

# Second server base URL used by scale-check.
# SCALE_CHECK_URL_2=http://127.0.0.1:4001

# Alias for SCALE_CHECK_URL_1; the explicitly set primary/alias takes precedence.
# SCALE_CHECK_URL_A=http://127.0.0.1:4000

# Alias for SCALE_CHECK_URL_2; the explicitly set primary/alias takes precedence.
# SCALE_CHECK_URL_B=http://127.0.0.1:4001

# Existing room id used by scale-check.
# SCALE_CHECK_ROOM=lobby

# Shared secret required in x-room-admin-token to save room layouts; empty disables editing.
# ROOM_ADMIN_TOKEN=change-me-to-a-secret-token

# Maximum furniture and wall obstacles allowed in a room layout (integer 1..10000).
# ROOM_LAYOUT_MAX_OBSTACLES=200

# Test-only MongoDB base URI; suites create and drop isolated databases.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/proxispeak

# Test-only Redis URL; set it to enable all Redis integration tests.
# REDIS_URL_TEST=redis://127.0.0.1:6379
