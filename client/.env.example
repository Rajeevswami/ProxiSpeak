# ProxiSpeak client — copy to client/.env if you need to override the
# server URL. Never commit a real client/.env.
#
# Empty (the default): http://localhost:4000 in dev, same origin in
# production. Set this only to point the client at a different server.
# VITE_SERVER_URL=http://localhost:4000

# Dev only. Vite answers requests whose Host header it recognises and
# replies 403 to anything else (DNS rebinding protection), which blocks a
# dev server reached through a preview URL or a tunnel. List the extra
# hostnames — or a suffix, e.g. ".trycloudflare.com" — comma separated.
# VITE_DEV_ALLOWED_HOSTS=.example.dev,localhost
