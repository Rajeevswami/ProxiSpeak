{
  "name": "proxispeak-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ProxiSpeak — geospatial proximity audio ecosystem (Express + Socket.io server)",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/index.js",
